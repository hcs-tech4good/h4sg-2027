# Required: all from the same Supabase development project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use your deployed H4SG origin in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development example only. Replace with the actual application window.
NEXT_PUBLIC_APP_OPENS=2026-11-01T00:00:00-05:00
NEXT_PUBLIC_APP_CLOSES=2027-03-01T23:59:00-05:00

# Optional: app announcement/decision emails, separate from Supabase Auth SMTP
POSTMARK_API_TOKEN=
EMAIL_FROM="Hack 4 Social Good <operations@t4sg.dev>"

# Optional: configure the matching secret in Supabase Auth
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
